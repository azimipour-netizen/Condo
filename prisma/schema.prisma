generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PropertyStatus {
  active
  sold
  terminated
  expired
  suspended
}

enum PropertyType {
  detached
  semi_detached
  townhouse
  condo
  multiplex
  vacant_land
  commercial
}

enum LocationDisplayMode {
  exact
  approximate
  neighbourhood
  hidden
}

enum UserRole {
  consumer
  agent
  admin
}

enum ShowingStatus {
  requested
  pending_review
  confirmed
  scheduled
  cancelled
  completed
}

enum SyncStatus {
  running
  completed
  failed
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  role                UserRole  @default(consumer)
  emailVerified       DateTime?
  documentsUnlocked   Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  savedProperties SavedProperty[]
  showingRequests ShowingRequest[]
  conversations   AIConversation[]
  accounts        Account[]
  sessions        Session[]
  questions       PropertyQuestion[]
  answers         PropertyAnswer[]
  uploadedDocuments Document[] @relation("DocumentUploader")
  receivedDocuments Document[] @relation("DocumentReceiver")
  savedSearches            SavedSearch[]
  passwordResetTokens      PasswordResetToken[]
  emailVerificationTokens  EmailVerificationToken[]
  blogPosts                BlogPost[]
}

// NextAuth tables
model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Property {
  id              String              @id @default(uuid())
  providerId      String
  listingId       String              @unique
  status          PropertyStatus      @default(active)
  price           Decimal             @db.Decimal(12, 2)
  propertyType    PropertyType
  bedrooms        Int
  bathroomsTotal  Decimal             @db.Decimal(4, 1)
  parkingSpaces   Int                 @default(0)
  sqft            Int?
  // Bucketed range ("3500-5000", "5000 +") — AMPRE's LivingAreaRange, the
  // only size signal available when exact sqft isn't reported (the norm for
  // residential freehold listings).
  sqftRange       String?
  lotSize         String?
  // The two nearest cross streets as reported by the listing agent, e.g.
  // "Yonge St/Sheppard Ave" — the most reliable field for verifying
  // proximity to a named intersection.
  crossStreet     String?
  yearBuilt       Int?
  maintenanceFee  Decimal?            @db.Decimal(10, 2)
  taxes           Decimal?            @db.Decimal(10, 2)
  // Sold data comes from the VOW feed and may only be shown to signed-in users.
  soldPrice       Decimal?            @db.Decimal(12, 2)
  soldDate        DateTime?
  transactionType String              @default("sale") // "sale" | "lease"
  title           String
  description     String              @db.Text
  features        String[]
  // Location
  latitude        Decimal?            @db.Decimal(10, 8)
  longitude       Decimal?            @db.Decimal(11, 8)
  displayMode     LocationDisplayMode @default(approximate)
  address         String?
  neighbourhood   String?
  city            String              @default("Toronto")
  province        String              @default("ON")
  postalCode      String?
  virtualTourUrl  String?
  // Raw provider data (for fields not yet normalized)
  providerData    Json?
  listedAt        DateTime            @default(now())
  syncedAt        DateTime            @default(now())
  createdAt       DateTime            @default(now())
  // Prisma bumps this on every write regardless of whether any field
  // actually changed — a routine sync touch (even a no-op upsert) moves it,
  // so it can't answer "when did this listing genuinely last change" (the
  // sitemap's lastmod needs that, not "when did sync last run").
  updatedAt       DateTime            @updatedAt
  // AMPRE's real ModificationTimestamp, carried straight through from the
  // feed. Nullable: existing rows won't have it until their next sync.
  sourceModifiedAt DateTime?

  images          PropertyImage[]
  showingRequests ShowingRequest[]
  openHouses      OpenHouse[]

  @@index([status])
  @@index([propertyType])
  @@index([price])
  @@index([bedrooms])
  @@index([city])
  @@index([neighbourhood])
  @@index([latitude, longitude])
  // Composite indexes for AVM comparables + neighbourhood stats queries
  @@index([status, propertyType, city])
  @@index([status, city, propertyType, sqft])
  // Comparable lookups scan recent sales inside a bounding box.
  @@index([status, soldDate])
  @@index([status, latitude, longitude, soldDate])
}

model PropertyImage {
  id         String   @id @default(uuid())
  propertyId String
  url        String
  order      Int      @default(0)
  alt        String?
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model SavedProperty {
  userId     String
  propertyId String
  savedAt    DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, propertyId])
}

model AIConversation {
  id           String       @id @default(uuid())
  userId       String?
  sessionId    String
  filtersState Json         @default("{}")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  user         User?        @relation(fields: [userId], references: [id])
  messages     AIMessage[]

  @@index([sessionId])
}

model AIMessage {
  id             String         @id @default(uuid())
  conversationId String
  role           String
  content        String         @db.Text
  toolCalls      Json?
  createdAt      DateTime       @default(now())
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model ShowingRequest {
  id          String        @id @default(uuid())
  propertyId  String
  userId      String?
  name        String
  email       String
  phone       String?
  preferredAt DateTime
  altAt       DateTime?
  status      ShowingStatus @default(requested)
  message     String?
  notes       String?       @db.Text
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  property    Property      @relation(fields: [propertyId], references: [id])
  user        User?         @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([propertyId])
}

model OpenHouse {
  id         String   @id @default(uuid())
  propertyId String
  startsAt   DateTime
  endsAt     DateTime
  notes      String?
  createdAt  DateTime @default(now())

  property      Property               @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  registrations OpenHouseRegistration[]

  @@index([propertyId])
  @@index([startsAt])
}

model OpenHouseRegistration {
  id          String   @id @default(uuid())
  openHouseId String
  name        String
  email       String
  phone       String?
  createdAt   DateTime @default(now())

  openHouse OpenHouse @relation(fields: [openHouseId], references: [id], onDelete: Cascade)

  @@unique([openHouseId, email])
  @@index([openHouseId])
}

model ContactInquiry {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([read])
}

model SyncJob {
  id           String     @id @default(uuid())
  provider     String
  status       SyncStatus
  recordsSynced Int       @default(0)
  error        String?
  startedAt    DateTime   @default(now())
  completedAt  DateTime?
}

model PropertyQuestion {
  id         String   @id @default(uuid())
  propertyId String
  userId     String
  text       String   @db.Text
  createdAt  DateTime @default(now())

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers PropertyAnswer[]

  @@index([propertyId])
  @@index([userId])
}

model PropertyAnswer {
  id         String   @id @default(uuid())
  questionId String
  agentId    String
  text       String   @db.Text
  createdAt  DateTime @default(now())

  question PropertyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  agent    User             @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model SavedSearch {
  id             String    @id @default(uuid())
  userId         String
  name           String
  filters        Json
  alertsEnabled  Boolean   @default(true)
  lastAlertedAt  DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// side: 'buyer' = uploaded by buyer about themselves
//       'agent' = uploaded by agent for/about the buyer
model BlogPost {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  summary        String
  metaDescription String?
  body           String   @db.Text
  coverImageUrl  String?
  // Optional GTA_CITIES slug (lib/seo/gta-cities.ts) tagging this post to one
  // city — drives the "homes for sale in X" sidebar CTA and same-city related
  // posts. Null for general/GTA-wide content.
  citySlug    String?
  authorId    String
  published   Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id])

  @@index([published])
  @@index([publishedAt])
  @@index([citySlug])
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String   @unique
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PriceHistory {
  id         String   @id @default(uuid())
  propertyId String
  price      Decimal  @db.Decimal(12, 2)
  recordedAt DateTime @default(now())

  @@index([propertyId])
  @@index([recordedAt])
}

model PageView {
  id         String   @id @default(uuid())
  path       String
  propertyId String?
  sessionId  String?
  createdAt  DateTime @default(now())

  @@index([path])
  @@index([propertyId])
  @@index([createdAt])
}

model Document {
  id           String   @id @default(uuid())
  uploaderId   String
  receiverId   String?
  side         String
  category     String
  label        String
  filename     String
  fileUrl      String
  fileSize     Int
  mimeType     String
  uploadedAt   DateTime @default(now())

  uploader  User  @relation("DocumentUploader", fields: [uploaderId], references: [id], onDelete: Cascade)
  receiver  User? @relation("DocumentReceiver", fields: [receiverId], references: [id])

  @@index([uploaderId])
  @@index([receiverId])
  @@index([side])
}
