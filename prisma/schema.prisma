generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PropertyStatus {
  active
  sold
  terminated
  expired
  suspended
}

enum PropertyType {
  detached
  semi_detached
  townhouse
  condo
  multiplex
  vacant_land
  commercial
}

enum LocationDisplayMode {
  exact
  approximate
  neighbourhood
  hidden
}

enum UserRole {
  consumer
  agent
  admin
}

enum ShowingStatus {
  requested
  pending_review
  confirmed
  scheduled
  cancelled
  completed
}

enum SyncStatus {
  running
  completed
  failed
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  role                UserRole  @default(consumer)
  emailVerified       DateTime?
  documentsUnlocked   Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  savedProperties SavedProperty[]
  showingRequests ShowingRequest[]
  conversations   AIConversation[]
  accounts        Account[]
  sessions        Session[]
  questions       PropertyQuestion[]
  answers         PropertyAnswer[]
  uploadedDocuments Document[] @relation("DocumentUploader")
  receivedDocuments Document[] @relation("DocumentReceiver")
}

// NextAuth tables
model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Property {
  id              String              @id @default(uuid())
  providerId      String
  listingId       String              @unique
  status          PropertyStatus      @default(active)
  price           Decimal             @db.Decimal(12, 2)
  propertyType    PropertyType
  bedrooms        Int
  bathroomsTotal  Decimal             @db.Decimal(4, 1)
  parkingSpaces   Int                 @default(0)
  sqft            Int?
  lotSize         String?
  yearBuilt       Int?
  maintenanceFee  Decimal?            @db.Decimal(10, 2)
  taxes           Decimal?            @db.Decimal(10, 2)
  title           String
  description     String              @db.Text
  features        String[]
  // Location
  latitude        Decimal?            @db.Decimal(10, 8)
  longitude       Decimal?            @db.Decimal(11, 8)
  displayMode     LocationDisplayMode @default(approximate)
  address         String?
  neighbourhood   String?
  city            String              @default("Toronto")
  province        String              @default("ON")
  postalCode      String?
  // Raw provider data (for fields not yet normalized)
  providerData    Json?
  listedAt        DateTime            @default(now())
  syncedAt        DateTime            @default(now())
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  images          PropertyImage[]
  showingRequests ShowingRequest[]

  @@index([status])
  @@index([propertyType])
  @@index([price])
  @@index([bedrooms])
  @@index([city])
  @@index([neighbourhood])
  @@index([latitude, longitude])
}

model PropertyImage {
  id         String   @id @default(uuid())
  propertyId String
  url        String
  order      Int      @default(0)
  alt        String?
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model SavedProperty {
  userId     String
  propertyId String
  savedAt    DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, propertyId])
}

model AIConversation {
  id           String       @id @default(uuid())
  userId       String?
  sessionId    String
  filtersState Json         @default("{}")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  user         User?        @relation(fields: [userId], references: [id])
  messages     AIMessage[]

  @@index([sessionId])
}

model AIMessage {
  id             String         @id @default(uuid())
  conversationId String
  role           String
  content        String         @db.Text
  toolCalls      Json?
  createdAt      DateTime       @default(now())
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model ShowingRequest {
  id          String        @id @default(uuid())
  propertyId  String
  userId      String?
  name        String
  email       String
  phone       String?
  preferredAt DateTime
  altAt       DateTime?
  status      ShowingStatus @default(requested)
  message     String?
  notes       String?       @db.Text
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  property    Property      @relation(fields: [propertyId], references: [id])
  user        User?         @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([propertyId])
}

model SyncJob {
  id           String     @id @default(uuid())
  provider     String
  status       SyncStatus
  recordsSynced Int       @default(0)
  error        String?
  startedAt    DateTime   @default(now())
  completedAt  DateTime?
}

model PropertyQuestion {
  id         String   @id @default(uuid())
  propertyId String
  userId     String
  text       String   @db.Text
  createdAt  DateTime @default(now())

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers PropertyAnswer[]

  @@index([propertyId])
  @@index([userId])
}

model PropertyAnswer {
  id         String   @id @default(uuid())
  questionId String
  agentId    String
  text       String   @db.Text
  createdAt  DateTime @default(now())

  question PropertyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  agent    User             @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

// side: 'buyer' = uploaded by buyer about themselves
//       'agent' = uploaded by agent for/about the buyer
model Document {
  id           String   @id @default(uuid())
  uploaderId   String
  receiverId   String?
  side         String
  category     String
  label        String
  filename     String
  fileUrl      String
  fileSize     Int
  mimeType     String
  uploadedAt   DateTime @default(now())

  uploader  User  @relation("DocumentUploader", fields: [uploaderId], references: [id], onDelete: Cascade)
  receiver  User? @relation("DocumentReceiver", fields: [receiverId], references: [id])

  @@index([uploaderId])
  @@index([receiverId])
  @@index([side])
}
